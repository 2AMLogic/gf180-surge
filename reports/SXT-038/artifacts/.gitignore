# SXT-038: reference streams that are regenerated byte-identically by
# `python3 tools/render_lp24_reference.py --cases all` (verified against the
# committed sha256 in each bundle's meta.json by step 1 of
# tools/run_sxt038_checks.py).  Unlike the SXT-037 tap bundles, this leaf's
# reference needs no oracle host, so only a representative subset of the raw
# streams is committed (edges = Driven, chords-clean = Clean, brass =
# Standard, edges-toggle = the reload path).  Every bundle's meta.json,
# verdicts and budget rows ARE committed.
bundle-chords-std/coeffs.jsonl
bundle-chords-std/units.bin
bundle-chords-std/regs.bin
bundle-phase1/coeffs.jsonl
bundle-phase1/units.bin
bundle-phase1/regs.bin
bundle-major7mk2/coeffs.jsonl
bundle-major7mk2/units.bin
bundle-major7mk2/regs.bin
bundle-edges-reso1/coeffs.jsonl
bundle-edges-reso1/units.bin
bundle-edges-reso1/regs.bin
bundle-edges-cut-hi/coeffs.jsonl
bundle-edges-cut-hi/units.bin
bundle-edges-cut-hi/regs.bin
bundle-edges-cut-lo/coeffs.jsonl
bundle-edges-cut-lo/units.bin
bundle-edges-cut-lo/regs.bin
bundle-phase1-substd/coeffs.jsonl
bundle-phase1-substd/units.bin
bundle-phase1-substd/regs.bin
.work/
